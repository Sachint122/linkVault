<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/cyber_surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/cyber_border">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Type badge container with cyber border -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_badge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/typeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_link"
                app:tint="@color/cyber_cyan"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textStyle="bold"
            android:textColor="@color/cyber_text_primary"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/itemChevron"
            app:layout_constraintStart_toEndOf="@id/iconContainer"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtitle (URL or File info) with neon cyan accent -->
        <TextView
            android:id="@+id/itemUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="12sp"
            android:textColor="@color/cyber_text_cyan"
            app:layout_constraintEnd_toStartOf="@id/itemChevron"
            app:layout_constraintStart_toEndOf="@id/iconContainer"
            app:layout_constraintTop_toBottomOf="@id/itemTitle" />

        <!-- AI summary (2 lines, filled by on-device AI) -->
        <TextView
            android:id="@+id/itemSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/cyber_text_secondary"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/itemChevron"
            app:layout_constraintStart_toEndOf="@id/iconContainer"
            app:layout_constraintTop_toBottomOf="@id/itemUrl" />

        <!-- Metadata badges container -->
        <LinearLayout
            android:id="@+id/metadataRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toStartOf="@id/moreButton"
            app:layout_constraintStart_toEndOf="@id/iconContainer"
            app:layout_constraintTop_toBottomOf="@id/itemSummary">

            <!-- Category Badge -->
            <TextView
                android:id="@+id/metaCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_offline"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="📁 Uncategorized"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp" />

            <!-- Tag Badge -->
            <TextView
                android:id="@+id/metaTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_offline"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- More Tags Count -->
            <TextView
                android:id="@+id/metaMoreTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_badge_offline"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="+4"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Dead link status -->
            <TextView
                android:id="@+id/metaStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_offline"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:textColor="@color/cyber_emerald"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Legacy fallback view for zero regression -->
            <TextView
                android:id="@+id/itemMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cyber_text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Chevron Expand Button -->
        <ImageButton
            android:id="@+id/itemChevron"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_btn_circle"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:contentDescription="Expand"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/cyber_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Pin Icon -->
        <ImageView
            android:id="@+id/pinIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/action_pin"
            android:src="@drawable/ic_star"
            android:visibility="gone"
            app:tint="@color/cyber_amber"
            app:layout_constraintEnd_toStartOf="@id/itemChevron"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="6dp" />

        <!-- More Button (3 dots) at bottom-right -->
        <ImageButton
            android:id="@+id/moreButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_more"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/cyber_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
